{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "maps": {
	  "host_name": {
		  "simulacrum": "💻",
		  "enterprise": "🚀️",
		  "republic": "📖️"
	  }
  },
  "blocks": [
    {
      "alignment": "left",
      "segments": [
		{
	  	  "foreground": "#77E4F7",
          "properties": {
            "style": "agnoster"
          },
          "style": "plain",
          "template": "{{ .HostName }} ",
          "type": "text"

		},
        {
          "foreground": "#77E4F7",
          "properties": {
            "style": "agnoster"
          },
          "style": "plain",
          "template": "{{ .Path }} ",
          "type": "path"
        },
        {
          "foreground": "#FFE700",
          "style": "plain",
          "template": "{{ .HEAD }} ",
          "type": "git"
        },
        {
          "foreground": "#43D426",
          "style": "plain",
          "template": "\u276f ",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "version": 3
}
